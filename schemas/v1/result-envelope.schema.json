{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "media_type",
        "uri"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "QACheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QAStatus"
        },
        "witness": {
          "additionalProperties": true,
          "title": "Witness",
          "type": "object"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "QACheckResult",
      "type": "object"
    },
    "QAReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/QACheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QAStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "QAReport",
      "type": "object"
    },
    "QAStatus": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "not_run"
      ],
      "title": "QAStatus",
      "type": "string"
    },
    "ResultValidity": {
      "enum": [
        "valid",
        "valid_with_warnings",
        "invalid"
      ],
      "title": "ResultValidity",
      "type": "string"
    },
    "SolverDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "actual_mip_gap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Mip Gap"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "backend_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend Version"
        },
        "best_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Bound"
        },
        "has_incumbent": {
          "title": "Has Incumbent",
          "type": "boolean"
        },
        "incumbent_objective": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incumbent Objective"
        },
        "normalized_status": {
          "$ref": "#/$defs/SolverStatus"
        },
        "orchestration_runtime_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orchestration Runtime S"
        },
        "qa_status": {
          "$ref": "#/$defs/QAStatus"
        },
        "requested_mip_gap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Mip Gap"
        },
        "result_validity": {
          "$ref": "#/$defs/ResultValidity"
        },
        "runtime_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime S"
        },
        "termination_condition": {
          "title": "Termination Condition",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "termination_condition",
        "normalized_status",
        "has_incumbent",
        "result_validity",
        "qa_status"
      ],
      "title": "SolverDiagnostics",
      "type": "object"
    },
    "SolverStatus": {
      "enum": [
        "optimal",
        "feasible",
        "time_limit",
        "infeasible",
        "unbounded",
        "numerical_error",
        "solver_error"
      ],
      "title": "SolverStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "qa": {
      "$ref": "#/$defs/QAReport"
    },
    "results": {
      "additionalProperties": true,
      "title": "Results",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "snapshot_fingerprint": {
      "title": "Snapshot Fingerprint",
      "type": "string"
    },
    "solver": {
      "$ref": "#/$defs/SolverDiagnostics"
    },
    "validity": {
      "$ref": "#/$defs/ResultValidity"
    }
  },
  "required": [
    "run_id",
    "snapshot_fingerprint",
    "created_at",
    "validity",
    "solver",
    "qa"
  ],
  "title": "ResultEnvelope",
  "type": "object"
}
