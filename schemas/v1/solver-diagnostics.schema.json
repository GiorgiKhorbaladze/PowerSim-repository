{
  "$defs": {
    "QAStatus": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "not_run"
      ],
      "title": "QAStatus",
      "type": "string"
    },
    "ResultValidity": {
      "enum": [
        "valid",
        "valid_with_warnings",
        "invalid"
      ],
      "title": "ResultValidity",
      "type": "string"
    },
    "SolverStatus": {
      "enum": [
        "optimal",
        "feasible",
        "time_limit",
        "infeasible",
        "unbounded",
        "numerical_error",
        "solver_error"
      ],
      "title": "SolverStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_mip_gap": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Mip Gap"
    },
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "backend_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend Version"
    },
    "best_bound": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Best Bound"
    },
    "effective_options": {
      "additionalProperties": true,
      "title": "Effective Options",
      "type": "object"
    },
    "has_incumbent": {
      "title": "Has Incumbent",
      "type": "boolean"
    },
    "incumbent_objective": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incumbent Objective"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "normalized_status": {
      "$ref": "#/$defs/SolverStatus"
    },
    "orchestration_runtime_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orchestration Runtime S"
    },
    "qa_status": {
      "$ref": "#/$defs/QAStatus"
    },
    "requested_backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Backend"
    },
    "requested_mip_gap": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Mip Gap"
    },
    "result_validity": {
      "$ref": "#/$defs/ResultValidity"
    },
    "runtime_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime S"
    },
    "solve_finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solve Finished At"
    },
    "solve_started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Solve Started At"
    },
    "termination_condition": {
      "title": "Termination Condition",
      "type": "string"
    }
  },
  "required": [
    "backend",
    "termination_condition",
    "normalized_status",
    "has_incumbent",
    "result_validity",
    "qa_status"
  ],
  "title": "SolverDiagnostics",
  "type": "object"
}
